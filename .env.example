# Copy to .env.local for development, or set in your hosting provider.
# Never commit real values.

# --- Site -------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Indexing is OFF unless this is exactly "true". Set it ONLY on the production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Google Search Console: the content value of the google-site-verification meta tag.
# Not needed for a Domain property (verified by a DNS TXT record).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Form delivery -------------------------------------------------------
# All forms (project inquiry and newsletter) are emailed to info@growbytes.co via
# Resend as soon as RESEND_API_KEY is set. Verify growbytes.co in Resend first.
# Set INQUIRY_ADAPTER=webhook to send inquiries to a webhook instead.
INQUIRY_ADAPTER=

# Webhook adapter: JSON POST to Zapier / Make / n8n / a CRM endpoint / your own API.
INQUIRY_WEBHOOK_URL=
# Optional; sent as "Authorization: Bearer <secret>".
INQUIRY_WEBHOOK_SECRET=

# Resend adapter (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
# Optional overrides. Defaults: to info@growbytes.co, from "Growbytes Website <website@growbytes.co>".
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Allow demo mode on a production build (e.g. a staging preview). Never on the live site.
INQUIRY_DEMO_MODE=false

# Newsletter sign-ups (footer). POSTs {email, source, subscribedAt} as JSON. Leave empty to show a "not connected yet" message.
NEWSLETTER_WEBHOOK_URL=

# --- Search Console (npm run gsc) ------------------------------------------
# Path to the Google service account JSON key. Keep the file outside git (e.g. ./secrets/gsc-key.json).
GSC_KEY_FILE=
# "sc-domain:growbytes.co" for a Domain property, or "https://growbytes.co/" for a URL-prefix property.
GSC_PROPERTY=sc-domain:growbytes.co
GSC_SITE_URL=https://growbytes.co

# --- Analytics (Google Analytics 4) ------------------------------------------
# Measurement ID for the site tag, e.g. G-XXXXXXXXXX. Leave empty to load no analytics.
# When set, the cookie and privacy policies mention Google Analytics automatically.
NEXT_PUBLIC_GA_ID=
# Numeric property ID for reports (npm run ga4). Add the service account as a Viewer in GA4.
GA4_PROPERTY_ID=

# --- PageSpeed Insights (npm run pagespeed) ----------------------------------
# Optional; raises the free quota. Create one under Google Cloud > APIs & Services > Credentials.
PAGESPEED_API_KEY=

# --- LinkedIn (npm run linkedin) ----------------------------------------------
# From https://www.linkedin.com/developers/apps (redirect URL: http://localhost:3999/callback)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Written by "npm run linkedin -- login"; the token lasts about 60 days.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_EXPIRES=
LINKEDIN_PERSON_URN=
# Company page: a SECOND app with only Community Management API (same redirect URL).
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# The number in linkedin.com/company/<id>/admin/
LINKEDIN_ORG_ID=
# Written by "npm run linkedin -- login --page".
LINKEDIN_PAGE_ACCESS_TOKEN=
LINKEDIN_PAGE_TOKEN_EXPIRES=

# Meta (Facebook Page + Instagram). See scripts/meta.mjs.
META_APP_ID=
META_APP_SECRET=
META_USER_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_ID=
