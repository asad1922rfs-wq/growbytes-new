# Copy to .env.local for development, or set in your hosting provider.
# Never commit real values.

# --- Site -------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Indexing is OFF unless this is exactly "true". Set it ONLY on the production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Google Search Console: the content value of the google-site-verification meta tag.
# Not needed for a Domain property (verified by a DNS TXT record).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Form delivery -------------------------------------------------------
# All forms (project inquiry and newsletter) are emailed to info@growbytes.co via
# Resend as soon as RESEND_API_KEY is set. Verify growbytes.co in Resend first.
# Set INQUIRY_ADAPTER=webhook to send inquiries to a webhook instead.
INQUIRY_ADAPTER=

# Webhook adapter: JSON POST to Zapier / Make / n8n / a CRM endpoint / your own API.
INQUIRY_WEBHOOK_URL=
# Optional; sent as "Authorization: Bearer <secret>".
INQUIRY_WEBHOOK_SECRET=

# Resend adapter (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
# Optional overrides. Defaults: to info@growbytes.co, from "Growbytes Website <website@growbytes.co>".
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Allow demo mode on a production build (e.g. a staging preview). Never on the live site.
INQUIRY_DEMO_MODE=false

# Newsletter sign-ups (footer). POSTs {email, source, subscribedAt} as JSON. Leave empty to show a "not connected yet" message.
NEWSLETTER_WEBHOOK_URL=
